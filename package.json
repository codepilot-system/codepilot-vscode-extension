{
  "name": "codepilot-vscode-extension",
  "version": "1.0.0",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onCommand:codepilot.triggerLocalScan",
    "onCommand:codepilot.applyPatch",
    "onCommand:codepilot.showSuggestions",
    "onCommand:codepilot.previewSuggestion",
    "onCommand:codepilot.applySuggestion",
    "onCommand:codepilot.validatePatch"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codepilot.triggerLocalScan",
        "title": "CodePilot: Trigger Local Scan"
      },
      {
        "command": "codepilot.applyPatch",
        "title": "CodePilot: Apply Patch"
      },
      {
        "command": "codepilot.showSuggestions",
        "title": "CodePilot: Show Suggestions"
      },
      {
        "command": "codepilot.previewSuggestion",
        "title": "CodePilot: Preview Suggestion"
      },
      {
        "command": "codepilot.applySuggestion",
        "title": "CodePilot: Apply Suggestion"
      },
      {
        "command": "codepilot.validatePatch",
        "title": "CodePilot: Validate Patch"
      }
    ]
  },
  "dependencies": {
    "axios": "^1.18.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^21.0.1",
    "@types/vscode": "^1.125.0",
    "@types/ws": "^8.18.1",
    "sinon": "^22.0.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "test": "vscode-test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codepilot-system/codepilot-vscode-extension.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/codepilot-system/codepilot-vscode-extension/issues"
  },
  "homepage": "https://github.com/codepilot-system/codepilot-vscode-extension#readme",
  "description": ""
}
